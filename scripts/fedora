#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# --- dnf
sudo dnf config-manager setopt fedora-cisco-openh264.enabled=1

RELEASE=$(rpm -E %fedora)

# add dnf repos
sudo dnf install -y \
    "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${RELEASE}.noarch.rpm" \
    "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${RELEASE}.noarch.rpm"

sudo dnf install --nogpgcheck \
    --repofrompath "terra,https://repos.fyralabs.com/terra${RELEASE}" \
    terra-release

# install packages
packages=(
    kitty
    # cli/tui
    7zip
    btop
    unzip
    # editor + tools
    neovim neovim-default-editor
    git
    # languages + package-managers
    rustup
    nix nix-daemon
    # containers
    podman podman-compose
    # multimedia codecs (RPM Fusion)
    ffmpeg gstreamer1-plugins-good-extras gstreamer1-plugins-bad-free-extras
    gstreamer1-plugins-ugly gstreamer1-libav gstreamer1-vaapi libva-utils
    # user-shell
    fish
)

groups=(
    development-tools
    c-development
    rpm-development-tools
)

# install & update
sudo dnf update -y --refresh
sudo dnf group install -y "${groups[@]}"
sudo dnf swap -y ffmpeg-free ffmpeg --allowerasing
sudo dnf install "${packages[@]}"
# clean up
sudo dnf autoremove -y
sudo dnf clean all

# --- nix
sudo systemctl enable --now nix-daemon.service
. /etc/profile.d/nix-daemon.sh

if nix profile list 2>/dev/null | grep -q '^Name:.*dotfiles'; then
    nix profile upgrade dotfiles
else
    nix profile add .
fi

# --- services
systemctl --user enable --now podman.socket

# --- dotfiles
dotbee sync den

# --- done
echo
echo "Fedora setup complete!"
echo
echo "Next steps:"
echo "  1. Restart your shell or run:  exec fish"
echo "  2. Verify dotfiles:            dotbee doctor"
echo "  3. Reboot (recommended) to pick up kernel/driver updates."
