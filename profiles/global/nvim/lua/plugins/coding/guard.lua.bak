---@type LazySpec
return {
    "nvimdev/guard.nvim",
    version = false,
    dev = true,
    dir = "~/Code/projects/other/guard.nvim/",
    init = function()
        vim.g.guard_config = {
            -- format
            always_save = false, -- always save file after call Guard fmt
            fmt_on_save = true, -- format on write to buffer
            lsp_as_default_formatter = true, -- use lsp if no formatter was defined for this filetype
            save_on_fmt = false, -- whether or not to save the buffer after formatting
            save_timeout = 5000, -- how long to wait for a formatter when formatting on save (ms)
            -- lint
            auto_lint = false, -- automatic linting
            lint_interval = 0, -- how frequently can linters be called
            refresh_diagnostic = true, -- show diagnostic after format done
        }
    end,
    config = function()
        local ft = require("guard.filetype")
        local languages = {
            ["c,cpp"] = { cmd = "clang-format", stdin = true },
            ["fish"] = { cmd = "fish_indent", stdin = true },
            ["json,jsonc"] = { cmd = "oxfmt", args = { "--stdin-filepath" }, fname = true, stdin = true },
            ["lua"] = { cmd = "stylua", args = { "-" }, stdin = true },
            ["markdown"] = { cmd = "oxfmt", args = { "--stdin-filepath" }, fname = true, stdin = true },
            ["meson"] = { cmd = "meson", args = { "format", "-", "--source-file-path" }, fname = true, stdin = true },
            ["typst"] = { cmd = "typstyle", stdin = true },
            ["rust"] = {
                cmd = "rustfmt",
                args = { "--edition", "2024", "--emit", "stdout" },
                stdin = true,
            },
        }

        -- stylua: ignore
        for lang, config in pairs(languages) do ft(lang):fmt(config) end
    end,
}
