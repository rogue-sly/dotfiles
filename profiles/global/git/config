; vim: ft=gitconfig
[user]
    name = Ali Mohammed
    email = ali.moh@tuta.io
    signingkey = ~/.ssh/git_signing.pub
[gitlab]
    user = rogue-sly
[init]
    defaultBranch = main
[core]
    compression = 9
    whitespace = error
    preloadindex = true
    pager = delta
[status]
    branch = true
    showStash = true
[diff]
    context = 3
    renames = copies
    interHunkContext = 10
    algorithm = histogram
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
[gpg]
    format = ssh
[commit]
    gpgsign = true
