# vim: ft=gitconfig
[user]
    name = rogue
    # please don't spam :]
	email = rogue87@tuta.io 
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[github]
  user = rogue-sly
[core]
	compression = 9
	whitespace = error
	preloadindex = true
	pager = delta
[status]
	branch = true
	showStash = true
[diff]
	context = 3
	renames = copies
	interHunkContext = 10
[url "git@github.com:rogue-sly"]
	insteadOf = "rogue:"
[url "git@github.com:"]
	insteadOf = "gh:"
[gpg]
	format = ssh
[commit]
	gpgSign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
